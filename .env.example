# Copiar a .env y ajustar. Todos los valores son opcionales.
PORT=3000
DB_PATH=./data/app.db

# Administrador inicial (solo se crea cuando la base de datos esta vacia)
ADMIN_NOMBRE=Administrador General
ADMIN_EMAIL=admin@inmo.local
ADMIN_PASSWORD=Admin1234

# Crear usuarios y datos de demostracion (agente, arquitecto, cliente)
SEED_DEMO=true

# En produccion (HTTPS) la cookie de sesion se marca como Secure
NODE_ENV=development
